# Backend runtime
TRYFIT_ENV=development
TRYFIT_HOST=127.0.0.1
TRYFIT_PORT=8000
TRYFIT_STORAGE_DIR=./data/private
TRYFIT_MAX_UPLOAD_BYTES=10485760
TRYFIT_MIN_IMAGE_WIDTH=256
TRYFIT_MIN_IMAGE_HEIGHT=256
TRYFIT_MAX_IMAGE_PIXELS=40000000
TRYFIT_RETENTION_MINUTES=45
TRYFIT_CLEANUP_INTERVAL_SECONDS=60
TRYFIT_MAX_PENDING_JOBS=10
TRYFIT_DATABASE_URL=sqlite:///./data/tryfit.db
TRYFIT_APP_BASE_URL=http://127.0.0.1:5173
TRYFIT_SESSION_DAYS=14
TRYFIT_VERIFICATION_MINUTES=30
TRYFIT_PASSWORD_RESET_MINUTES=30
TRYFIT_INVITATION_DAYS=7

# Email is optional for local development (links are shown in the UI).
# Configure SMTP before deploying so verification, reset, and invitation links are delivered privately.
TRYFIT_SMTP_HOST=
TRYFIT_SMTP_PORT=587
TRYFIT_SMTP_USERNAME=
TRYFIT_SMTP_PASSWORD=
TRYFIT_SMTP_SENDER=TryFit BD <no-reply@tryfitbd.local>
TRYFIT_SMTP_STARTTLS=true

# AI model selection. For AMD, use a supported ROCm PyTorch host and TRYFIT_DEVICE=rocm.
TRYFIT_MODEL_NAME=unselected
TRYFIT_DEVICE=auto
# Uncomment and set for a configured CatVTON host:
# TRYFIT_CATVTON_SOURCE=./third_party/CatVTON
# TRYFIT_CATVTON_WIDTH=576
# TRYFIT_CATVTON_HEIGHT=768
# TRYFIT_CATVTON_STEPS=25

# The frontend uses Vite's /api proxy by default. If overriding it, set
# VITE_API_BASE in frontend/.env.local (not in this backend settings file).
